# Environment Configuration Template for Storage Health Monitor
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it's in .gitignore)

# ==================================================
# EMAIL ALERT CONFIGURATION (Gmail)
# ==================================================

# Your Gmail address (the one that will send alerts)
EMAIL_SENDER=your-email@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# How to get this:
#   1. Go to: https://myaccount.google.com/apppasswords
#   2. Select "Mail" and generate password
#   3. Copy the 16-character password here
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Email addresses to receive alerts (comma-separated)
EMAIL_RECIPIENTS=admin@example.com,team@example.com

# ==================================================
# OPTIONAL: WEBHOOK ALERTS
# ==================================================

# Webhook URL (e.g., Slack, Discord, Teams)
WEBHOOK_URL=https://hooks.example.com/storage-alerts

# Enable webhook alerts (true/false)
WEBHOOK_ENABLED=false
